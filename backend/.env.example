# FastAPI Database Connection (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///agritech.db

# Cryptographic salt for hashing ESP8266 pre-shared API keys
DEVICE_SECRET_SALT=krishinidhi_smart_plant_salt_2026

# Secret key for JWT session signing
JWT_SECRET=super_secret_jwt_key_change_in_prod

# Google Gemini API key for Natural Language Agronomic Explanations (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
# Floating assistant: server-only OpenRouter key, never NEXT_PUBLIC_*.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
ASSISTANT_REQUESTS_PER_MINUTE=6
ASSISTANT_DAILY_REQUEST_LIMIT=200

# Optional Twilio credentials for SMS alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# Device authentication token (shared with ESP8266 hardware/config.py)
DEVICE_TOKEN=replace-with-a-long-random-secret

# Admin token for dashboard control requests
ADMIN_TOKEN=super_secret_admin_token_2026

# Server network binding (0.0.0.0 allows LAN access from ESP8266)
HOST=0.0.0.0
PORT=8000

