# KrishiNidhi Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml or paste into Streamlit Community Cloud App Settings -> Secrets

# Gemini API Key for Crop Doctor Vision & Generative AI Action Plans
GEMINI_API_KEY = "your_gemini_api_key_here"

# OpenRouter API Key for Multilingual AI Assistant (English, Telugu, Hindi)
OPENROUTER_API_KEY = "your_openrouter_api_key_here"
OPENROUTER_MODEL = "openrouter/free"

# Optional Twilio Alerting Credentials
TWILIO_ACCOUNT_SID = ""
TWILIO_AUTH_TOKEN = ""
TWILIO_FROM_NUMBER = ""
TWILIO_TO_NUMBER = ""
